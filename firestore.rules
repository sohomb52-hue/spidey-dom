rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUserProfile(data) {
      return data.displayName is string &&
        data.displayName.size() > 0 &&
        data.displayName.size() <= 100 &&
        data.email is string &&
        data.email.size() <= 200 &&
        data.totalScore is number &&
        data.totalScore >= 0 &&
        data.totalXP is number &&
        data.totalXP >= 0 &&
        data.totalQuestions is number &&
        data.totalQuestions >= 0 &&
        data.correctAnswers is number &&
        data.correctAnswers >= 0 &&
        data.bestStreak is number &&
        data.bestStreak >= 0 &&
        data.currentStreak is number &&
        data.currentStreak >= 0 &&
        data.factsDiscovered is number &&
        data.factsDiscovered >= 0 &&
        data.gamesPlayed is number &&
        data.gamesPlayed >= 0 &&
        data.achievementsUnlocked is number &&
        data.achievementsUnlocked >= 0;
    }

    function isValidGameSession(data) {
      return data.userId == request.auth.uid &&
        data.gameMode is string &&
        data.gameMode.size() <= 100 &&
        data.score is number &&
        data.score >= 0 &&
        data.questionsAnswered is number &&
        data.questionsAnswered >= 0 &&
        data.correctAnswers is number &&
        data.correctAnswers >= 0 &&
        data.accuracy is number &&
        data.accuracy >= 0 &&
        data.accuracy <= 100 &&
        data.bestStreak is number &&
        data.bestStreak >= 0 &&
        data.xpEarned is number &&
        data.xpEarned >= 0;
    }

    function isValidFact(data) {
      return data.userId == request.auth.uid &&
        data.factId is string &&
        data.factId.size() <= 100;
    }

    function isValidAchievement(data) {
      return data.userId == request.auth.uid &&
        data.achievementId is string &&
        data.achievementId.size() <= 100;
    }

    // User profile document: strictly isolated to the authenticated owner
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Blanket user list enumeration is forbidden
      allow create: if isOwner(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidUserProfile(incoming());
      allow delete: if false;

      // User game sessions subcollection
      match /gameSessions/{sessionId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGameSession(incoming());
        allow update, delete: if false;
      }

      // User discovered facts subcollection
      match /discoveredFacts/{factId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidFact(incoming());
        allow delete: if false;
      }

      // User unlocked achievements subcollection
      match /achievements/{achievementId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidAchievement(incoming());
        allow delete: if false;
      }
    }
  }
}
